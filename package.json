{
  "name": "@yelo/magpie-slowdown",
  "version": "0.0.0",
  "description": "Magpie middleware that slows down streamed token responses.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "main": "slowdown.middleware.js",
  "files": [
    "slowdown.middleware.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imyelo/magpie-slowdown.git"
  },
  "homepage": "https://github.com/imyelo/magpie-slowdown#readme",
  "bugs": "https://github.com/imyelo/magpie-slowdown/issues",
  "keywords": [
    "magpie",
    "magpie-middleware",
    "llm-gateway",
    "llm",
    "streaming",
    "sse",
    "server-sent-events",
    "throttle",
    "stream-throttle",
    "coalescing",
    "agent",
    "debugging"
  ],
  "publishConfig": {
    "access": "public"
  },
  "magpie": {
    "middleware": "./slowdown.middleware.js",
    "options": {
      "enabled": false,
      "intervalMs": 50,
      "maxBufferSize": 1000
    }
  },
  "scripts": {
    "test": "node test.mjs",
    "release": "np"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "np": "^12.1.1"
  }
}
